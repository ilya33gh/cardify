# Cardify Environment & Build Secrets Template
# Cardify is a 100% offline, local-first Android app and does NOT require external API keys.
# This file serves as a reference template if extending Cardify with external services.

# Application Configuration
APP_NAME=cardify
APPLICATION_ID=com.cardify.app

# Release Signing Properties (used in release builds)
# RELEASE_STORE_FILE=keystore/release.jks
# RELEASE_STORE_PASSWORD=your_store_password
# RELEASE_KEY_ALIAS=your_key_alias
# RELEASE_KEY_PASSWORD=your_key_password
